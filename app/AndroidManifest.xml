<?xml version="1.0" encoding="utf-8"?>
<!--
  Descargas: ver y ordenar lo que hay en la carpeta Descargas.
  Permisos (la lista completa; no hay ningún otro):
  - MANAGE_EXTERNAL_STORAGE: ver los archivos de Descargas que bajaron otras apps (PDF, ZIP, APK…).
    Android no ofrece un permiso solo para esa carpeta; lo apruebas tú en Ajustes.
  - READ/WRITE_EXTERNAL_STORAGE: lo mismo en Android 10 o anterior.
  - REQUEST_INSTALL_PACKAGES: poder abrir un APK descargado para instalarlo. Android igual te pregunta
    antes de instalar nada.
  No pide INTERNET: Android no le permite conectarse a nada, así que tus archivos no pueden salir del teléfono.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cl.cmitjans.descargas">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Descargas"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".Principal"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VerZip"
            android:exported="false" />

        <!-- Entrega un archivo a la app que lo abre, solo para leer y solo cuando tú lo eliges -->
        <provider
            android:name=".Proveedor"
            android:authorities="cl.cmitjans.descargas.archivos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
